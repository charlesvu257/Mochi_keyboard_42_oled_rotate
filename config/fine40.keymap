/*
 * fine!40 — 2-layer keymap
 *
 * Mirrors the live ZMK Studio layout as of 2026-08-07, so the compiled
 * fallback matches what's actually on the board. Derived from Aidan Smith's
 * original 4-layer keymap (2021).
 *
 * SPDX-License-Identifier: MIT
 *
 * While this board is managed through ZMK Studio, edits to the bindings below
 * do NOT reach the device — Studio's saved settings take precedence. They only
 * apply after a "Restore Stock Settings" in Studio. What DOES take effect
 * regardless is the encoder sensor-bindings, since Studio cannot configure
 * encoders.
 *
 * Layer count is kept at 4 (2 real + 2 reserved) to match the previous build,
 * so Studio's stored layer state maps across cleanly.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    // Encoder convention for &inc_dec_kp: first keycode is clockwise
    // (rotate right), second is counter-clockwise (rotate left).
    // If the board is wired the other way round, swap the pair.

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ---------------------------------------------------------------------------------
            // | ESC  |  Q   |  W   |  E   |  R   |  T   |  Y  |  U   |  I   |  O   |  P   | BSPC |
            // | TAB  |  A   |  S   |  D   |  F   |  G   |  H  |  J   |  K   |  L   |  ;   | RET  |
            // | CAPS |  Z   |  X   |  C   |  V   |  B   |  N  |  M   |  ,   |  .   |  UP  |  '   |
            // | LCTL | LGUI | LALT |  FN  | SPC  | SHFT | --- |  /   | LEFT | DOWN | RGHT | RET  |
            // ---------------------------------------------------------------------------------
            // Last key on the bottom row is the encoder push-switch.
            // Arrows form an inverted-T: UP on row 3, LEFT/DOWN/RIGHT on row 4.

            bindings = <
&kp ESC    &kp Q     &kp W     &kp E  &kp R      &kp T      &kp Y  &kp U     &kp I      &kp O     &kp P      &kp BSPC
&kp TAB    &kp A     &kp S     &kp D  &kp F      &kp G      &kp H  &kp J     &kp K      &kp L     &kp SEMI   &kp RET
&kp CAPS   &kp Z     &kp X     &kp C  &kp V      &kp B      &kp N  &kp M     &kp COMMA  &kp DOT   &kp UP     &kp SQT
&kp LCTRL  &kp LGUI  &kp LALT  &mo 1  &kp SPACE  &kp LSHFT  &none  &kp FSLH  &kp LEFT   &kp DOWN  &kp RIGHT  &kp RET
            >;

            // Encoder: CCW = Left arrow, CW = Right arrow.
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };

        fn_layer {
            display-name = "Fn";

            // ---------------------------------------------------------------------------------
            // |   `   |  1   |  2   |  3  |  4  |  5  |  6  | 7    |  8   |  9   |  0  | DEL   |
            // |  ---  | F1   | F2   | F3  | F4  | F5  | F6  | -    |  =   |  {   |  }  | ---   |
            // |  ---  | F7   | F8   | F9  | F10 | F11 | F12 | ---  |  <   |  >   | --- | ---   |
            // |  ---  | ---  | ---  | --- | UNLK| --- | --- | HOME | PGDN | PGUP | END | BOOT  |
            // ---------------------------------------------------------------------------------
            // Bootloader is on Fn + encoder click.
            // UNLK (&studio_unlock, on Fn + Space) is what unlocks ZMK Studio for editing.
            //
            // The three Bluetooth profile keys used to sit at the start of the
            // bottom row. They're left unbound (&none) rather than restored to
            // &bt BT_CLR / BT_SEL for now — that's layout work for later, not
            // part of this port.

            bindings = <
&kp GRAVE  &kp N1   &kp N2   &kp N3  &kp N4          &kp N5   &kp N6   &kp N7     &kp N8         &kp N9       &kp N0    &kp DEL
&trans     &kp F1   &kp F2   &kp F3  &kp F4          &kp F5   &kp F6   &kp MINUS  &kp EQUAL      &kp LBRC     &kp RBRC  &trans
&trans     &kp F7   &kp F8   &kp F9  &kp F10         &kp F11  &kp F12  &trans     &kp LS(COMMA)  &kp LS(DOT)  &trans    &trans
&none      &none    &none    &none   &studio_unlock  &trans   &trans   &kp HOME   &kp PG_DN      &kp PG_UP    &kp END   &bootloader
            >;

            // Encoder: CCW = Up arrow, CW = Down arrow.
            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        // Spare layers so ZMK Studio can add more without a reflash.
        // (Studio cannot create layers beyond what devicetree declares.)
    };
};
