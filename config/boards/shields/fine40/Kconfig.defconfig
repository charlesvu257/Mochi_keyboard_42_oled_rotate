if SHIELD_fine40

config ZMK_KEYBOARD_NAME
    default "NINO"

config I2C
	default y

config SSD1306
	default y

# --- Custom OLED status screen ---

choice ZMK_DISPLAY_STATUS_SCREEN
	default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
	imply NINO_DISPLAY

config LV_Z_MEM_POOL_SIZE
	default 4096 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

# Animating at 25fps on the main thread would add latency to keypresses.
choice ZMK_DISPLAY_WORK_QUEUE
	default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

config NINO_DISPLAY
	bool "NINO status screen: splash, carriage, margin bell, globe"
	select LV_USE_CANVAS
	select LV_USE_IMG
	select ZMK_HID_INDICATORS
	help
	  Boot splash spelling NINO, a typewriter carriage that steps one pixel
	  per character, a margin bell, a carriage-return slam with screen shake,
	  and a wireframe globe driven by the encoder.

if NINO_DISPLAY

config NINO_PANEL_ROTATED
	bool "Panel is mounted a quarter turn over"
	default y
	help
	  The framebuffer is always 128x32, but this module is mounted portrait,
	  so on the glass the 128-pixel axis runs top to bottom. Everything is
	  drawn in screen space and rotated on the way out. Turn off for a panel
	  mounted the normal way round.

config NINO_PANEL_FLIP
	bool "Rotate the other way"
	depends on NINO_PANEL_ROTATED
	help
	  Which of the two quarter turns a rotated panel sits at cannot be known
	  from the devicetree. If the splash reads upside down, set this.

config NINO_INVERT
	bool "Swap ink and background"
	help
	  Normally the panel is dark with light pixels, inverting while Caps Lock
	  is on. Enable this if it reads the other way round on your hardware.

config NINO_FRAME_MS
	int "Frame interval in milliseconds"
	default 40
	help
	  40ms is 25fps. Pushing a 512-byte 128x32 frame over I2C at 400kHz costs
	  roughly 12ms, so there is room here.

# --- Boot splash ---

config NINO_SPLASH_MS
	int "How long the NINO splash stays up, in milliseconds"
	default 2500
	help
	  Any keypress or knob movement dismisses it early.

# --- Carriage ---

config NINO_LINE_LENGTH
	int "Characters in a line before the carriage stops advancing"
	default 72
	help
	  One pixel of travel per character, so this is also the length of the
	  carriage track in pixels. Must fit between NINO_TRACK_TOP and the
	  globe; on a 128-pixel-tall panel, 72 leaves comfortable room.

config NINO_BELL_COLUMN
	int "Column at which the margin bell rings"
	default 65
	help
	  Rings once per line, on the way past. Backspacing below it re-arms it.

config NINO_SLAM_SPEED
	int "Carriage return speed, in pixels per frame"
	default 24
	help
	  The carriage advances one pixel per character but returns at this
	  speed, so a full line snaps back in about three frames.

config NINO_SHAKE_FRAMES
	int "Frames of screen shake on carriage return"
	default 2

# --- Globe ---

config NINO_BALL_RADIUS
	int "Globe radius in pixels"
	default 12
	help
	  Capped by the panel's short axis: at 12 the globe spans 25 of the 32
	  available pixels.

config NINO_BALL_STEP
	int "Rotation per detent, in sixteenths of a sine-table step"
	default 64
	help
	  There are 1024 units to a full turn, so the default of 64 is an eighth
	  turn, 22.5 degrees, per click.

config NINO_BALL_INVERT
	bool "Reverse which way the knob turns the globe"
	default y
	help
	  Whether a clockwise detent reports as positive depends on how the
	  encoder is wired, and this board reports it backwards — hence the
	  default. Clear it if the globe turns against the knob.

config NINO_BALL_MIN_MS
	int "Shortest gap between knob nudges, in milliseconds"
	default 60
	help
	  Rate limit for encoder events, which may arrive several times per
	  detent depending on the encoder's resolution.

config NINO_KNOB_POSITION
	int "Keymap position of the encoder push-switch"
	default 47
	help
	  Clicking it flashes the globe. It is also bound to Return, so a click
	  fires the carriage slam at the same time.

# --- Diagnostics ---

config NINO_TEST_PATTERN
	bool "Show a panel geometry check instead of the normal screen"
	help
	  Draws the panel edges, a square, and a circle inscribed in that square.
	  On correct geometry the rectangle sits exactly on the glass edges and
	  the circle touches the square at the midpoint of each side.

endif # NINO_DISPLAY

if LVGL

# The whole panel is redrawn every frame, so render it in a single pass rather
# than tiling it. At 1 bit per pixel a 100% buffer is only ~1 KB.
config LV_Z_VDB_SIZE
	default 100

config LV_DPI_DEF
	default 148

config LV_Z_BITS_PER_PIXEL
	default 1

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif
