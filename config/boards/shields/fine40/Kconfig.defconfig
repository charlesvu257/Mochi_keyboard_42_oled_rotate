if SHIELD_fine40

config ZMK_KEYBOARD_NAME
    default "fine!40"

config I2C
	default y

config SSD1306
	default y

# --- Custom OLED status screen: full-screen keystroke ripple ---

choice ZMK_DISPLAY_STATUS_SCREEN
	default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
	imply FINE40_RIPPLE

config LV_Z_MEM_POOL_SIZE
	default 4096 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

# Animating at 20fps on the main thread would add latency to keypresses.
choice ZMK_DISPLAY_WORK_QUEUE
	default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

config FINE40_RIPPLE
	bool "Full-screen keystroke ripple status screen"
	select LV_USE_CANVAS
	select LV_USE_IMG
	select ZMK_HID_INDICATORS
	help
	  Every key press sends an expanding wavefront out from the point on the
	  OLED matching that physical key. Caps Lock inverts the whole panel.

if FINE40_RIPPLE

config FINE40_RIPPLE_CUBE
	bool "Wireframe cube in the middle of the panel"
	default y
	help
	  A 3D wireframe cube sits permanently at the centre and turns when the
	  knob clicks, following the encoder's keymap bindings: the base layer
	  moves left and right so the cube yaws, any layer above moves up and
	  down so it pitches. Drawn solid, on top of the wave field.

config FINE40_RIPPLE_PANEL_ROTATED
	bool "Panel is mounted a quarter turn over"
	default y
	help
	  The framebuffer is always 128x32, but this module is mounted portrait,
	  so on the glass the 128-pixel axis runs top to bottom. The cube needs
	  to know, or a yaw would show up as a tumble. Turn off for a panel
	  mounted the normal way round.

config FINE40_CUBE_INVERT
	bool "Reverse which way the knob turns the cube"
	default y
	depends on FINE40_RIPPLE_CUBE
	help
	  Whether a clockwise detent reports as positive depends on how the
	  encoder is wired, and this board reports it backwards — hence the
	  default. Clear it if the cube turns against the knob.

config FINE40_CUBE_SCALE
	int "Cube size, as a projection scale factor"
	default 22
	help
	  Larger is bigger. Hard-capped by the panel's short axis: at 22 the
	  cube spans about 26 of the 32 available pixels at its widest
	  orientation, so there is not much room above this before corners
	  start clipping.

config FINE40_CUBE_STEP
	int "Rotation per detent, in sixteenths of a sine-table step"
	default 64
	help
	  There are 1024 units to a full turn, so the default of 64 is an
	  eighth turn, 22.5 degrees, per click.

config FINE40_CUBE_MIN_MS
	int "Shortest gap between knob nudges, in milliseconds"
	default 60
	help
	  Rate limit for encoder events, which may arrive several times per
	  detent depending on the encoder's resolution.

config FINE40_RIPPLE_INVERT
	bool "Swap ripple and background colours"
	help
	  Normally the field is black with white ripples, inverting to white with
	  black ripples while Caps Lock is on. Enable this if the panel reads the
	  other way round on your hardware.

config FINE40_RIPPLE_CAPS_SHOCKWAVE
	bool "Emit a ripple from the centre when Caps Lock toggles"
	default y

config FINE40_RIPPLE_FRAME_MS
	int "Frame interval in milliseconds"
	default 40
	help
	  40ms is 25fps. Pushing a 512-byte 128x32 frame over I2C at 400kHz costs
	  roughly 12ms, so there is room here, but the bus is shared with nothing
	  else and there is no reason to run it hotter than the eye needs.

config FINE40_RIPPLE_SPEED_X10
	int "Wavefront speed, in tenths of a pixel per frame"
	default 12
	help
	  Lifetime in frames is MAX_RADIUS divided by this, so slowing the wave
	  down is the cheap way to make ripples last longer: it costs nothing
	  extra to draw, unlike raising MAX_RADIUS.

config FINE40_RIPPLE_MAX_RADIUS
	int "Radius at which a wavefront has spent all its energy"
	default 64
	help
	  Roughly two panel heights, so a wave crosses and bounces a couple of
	  times before it dies. Without reflection enabled this wants to be near
	  the panel's short dimension instead, or a wave spends most of its life
	  with the top and bottom of the ring off-screen, leaving only the left
	  and right arcs visible — which reads as horizontal stretching.

config FINE40_RIPPLE_WAVELENGTH
	int "Pixels between concentric wavefronts of one impact"
	default 6

config FINE40_RIPPLE_MAX_ACTIVE
	int "Maximum simultaneous ripples"
	default 10
	help
	  Once this many are in flight, a new key press recycles the oldest,
	  which looks like a ripple vanishing mid-life. This has to scale with
	  lifetime: at roughly two seconds per ripple, normal typing keeps about
	  ten alive at once. Each ripple costs five rings (its own plus four
	  reflections), so this is also the first knob to turn down if the
	  animation stutters.

config FINE40_RIPPLE_REFLECT_PCT
	int "Energy retained when a wave bounces off a wall, in percent"
	default 70
	range 0 100
	help
	  0 disables reflection, and waves simply run off the edge of the panel.

config FINE40_RIPPLE_INTERFERENCE
	bool "Let overlapping wavefronts cancel each other"
	default y
	help
	  Draws wavefronts by inverting pixels rather than setting them, so two
	  waves crossing cancel where they meet. Turn off for plain stacking.

config FINE40_RIPPLE_ASPECT_PCT
	int "Horizontal wave radius as a percentage of the vertical radius"
	default 100
	range 10 200
	help
	  Correction for panels whose pixels are not square. 100 draws true
	  circles in pixel space. If circles come out as wide ovals, lower this;
	  a panel with pixels twice as wide as they are tall wants 50. Enable
	  FINE40_RIPPLE_TEST_PATTERN to measure it.

config FINE40_RIPPLE_TEST_PATTERN
	bool "Show a panel geometry check until the first key press"
	help
	  Draws the panel edges, a square, and a circle inscribed in that square.
	  On correct geometry the rectangle sits exactly on the glass edges and
	  the circle touches the square at the midpoint of each side.

endif # FINE40_RIPPLE

if LVGL

# The whole panel is redrawn every frame, so render it in a single pass rather
# than tiling it. At 1 bit per pixel a 100% buffer is only ~1 KB.
config LV_Z_VDB_SIZE
	default 100

config LV_DPI_DEF
	default 148

config LV_Z_BITS_PER_PIXEL
	default 1

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif
